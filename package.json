{
  "name": "@igorskyflyer/unite",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript library for deriving a union type, a type guard, and an array validator from a single source array.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@igorskyflyer/biome-config": "^3.0.3",
    "@igorskyflyer/tsconfig": "^2.0.1",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --run --passWithNoTests",
    "pub": "pnpm test && pnpm build && git push origin main --tags",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Igor Dimitrijević <support@igorskyflyer.me> (https://github.com/igorskyflyer)",
  "funding": "https://ko-fi.com/igorskyflyer",
  "homepage": "https://github.com/igorskyflyer/npm-unite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorskyflyer/npm-unite.git"
  },
  "bugs": {
    "url": "https://github.com/igorskyflyer/npm-unite/issues"
  },
  "keywords": [
    "union",
    "safe-guard",
    "const",
    "validation",
    "validator",
    "runtime",
    "declaration",
    "types",
    "source",
    "igor dimitrijević",
    "igorskyflyer"
  ]
}
